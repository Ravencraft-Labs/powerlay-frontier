# Dependencies
node_modules/
node_modules.zip

# Build outputs
dist/
*.tsbuildinfo

# Move build output
packages/move/**/build/

# Local user plugins (never shipped or committed)
/plugins/

# Raw game data (large; keep local), except the Map POC base layer: Cycle 6 system positions
# from our own client extraction (scripts/poc-map/build-base.mjs), needed in packaged builds.
/data/*
!/data/poc-map/
/data/poc-map/*
!/data/poc-map/base.json

# Python venv for static data extractor
scripts/extract/.venv/
scripts/extract/**/__pycache__/
scripts/extract/*.egg-info/
scripts/extract/.pytest_cache/

# Extracted runs (raw is already ignored via data/)

# Cursor / IDE
.cursorrules
.cursor/
.claude
help_db

# Debug logs
debug-*.log
*.log

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.local
.env.*.local
.envrc

# Electron
out/
release/

# Root shell scripts
/*.sh

CLAUDE.md
tasks.md
.claude-memory

# test files
_*

# Python dunder files in scripts/extract/ (override the `_*` rule above)
!scripts/extract/**/__init__.py
!scripts/extract/**/__main__.py
!scripts/extract/**/_cfsd.py
